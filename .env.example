# CadastreGIS Configuration Template
# Copy this file to .env and configure as needed.
# DO NOT commit real API secrets to source control.

# Authentication for RGURS / e-Katastar Geoserver WFS service (if querying protected layers)
CADASTRE_AUTH_KEY=your_auth_key_here

# Administrative target
CADASTRE_CITY_ID=35
CADASTRE_CITY_NAME=Доњи Жабар
CADASTRE_CITY_NAME_LATIN=Donji Zabar
CADASTRE_KO_ID=57062

# WFS and API endpoints
CADASTRE_WFS_URL=https://ekatastar.rgurs.org/geoserver/WS_RPJ_RS/wfs
CADASTRE_WFS_LAYER=WS_RPJ_RS:OL_PARCELE_JAVNI_UVID
CADASTRE_OWNER_API_BASE=https://ekatastar.rgurs.org/api/kc

# Networking & Scraper concurrency
CADASTRE_MAX_THREADS=16
CADASTRE_REQUEST_TIMEOUT=15

# Web Server & Basemaps
CADASTRE_WEB_HOST=127.0.0.1
CADASTRE_WEB_PORT=5000
CADASTRE_WEB_DEBUG=false
CARTO_API_KEY=your_carto_api_key_here
